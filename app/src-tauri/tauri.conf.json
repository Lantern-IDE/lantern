{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lantern",
  "version": "0.1.2",
  "identifier": "dev.lantern.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "Lantern",
    "copyright": "© 2026 Lantern",
    "category": "DeveloperTool",
    "shortDescription": "내 프로젝트를 이해하는, 가볍고 자유로운 AI IDE",
    "longDescription": "Lantern is a lightweight AI code editor that understands your project context. Bring your own model (API key or local).",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBRkRFQkZFNUY1MTU5RkIKUldUN1dWRmYvdXY5U21kWWhwT2RONXEwbFI5blJqQ21ROWNnbEpLdDZtT1RYeDlHaGc3cG1UNnEK",
      "endpoints": [
        "https://github.com/Lantern-IDE/lantern/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}